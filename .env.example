GOOGLE_ADS_CLIENT_ID=INSERT_OAUTH_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=INSERT_OAUTH_CLIENT_SECRET
# Connect using google_ads_start_local_oauth_flow after starting the MCP.
# Optional: manager account ID only when access is through an MCC.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_USE_PROTO_PLUS=true
